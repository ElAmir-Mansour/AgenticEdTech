# Google Gemini API key (Obtained from aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here

# Database Configurations
# For local dev fallback, SQLite will be used if DATABASE_URL is empty or uses sqlite:///
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/edtech

# Qdrant Vector DB Configurations
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here

# Security Settings
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
HOST=0.0.0.0
PORT=8080
ENV=development
